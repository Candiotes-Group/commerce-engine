# Anthropic — used to generate every bot reply
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Supabase — service role key only, never the anon key, never exposed to a browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp webhook verification token.
# Every client's Meta app, whatever app owns their WABA, points its webhook
# at this same deployment's /api/webhooks/whatsapp URL and must use this
# same verify token when Meta asks to verify the callback.
WHATSAPP_VERIFY_TOKEN=
